# Copiar a .env y completar. Nunca commitear .env real.

# --- Base de datos ---
DATABASE_URI=postgresql://laboratorio:cambiar_esto@localhost:5432/laboratorio_db

# --- Payload CMS ---
# Generar con: openssl rand -base64 32
PAYLOAD_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio

# --- Almacenamiento de medios (S3/MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=laboratorio-media
S3_ACCESS_KEY_ID=cambiar_esto
S3_SECRET_ACCESS_KEY=cambiar_esto
S3_REGION=us-east-1

# --- Cifrado de campo (formularios, M6) ---
# Generar con: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=cambiar_esto_por_32_bytes_en_hex

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
